// TruHost data model. docs/spec.md §3 is the design reference; keep the two in step.
// Constraints Prisma cannot express (partial uniques, exclusions, CHECKs, immutability triggers)
// live in raw SQL inside the migrations; see docs/spec.md "Constraints added as raw SQL".

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Identity & access ─────────────────────────

enum StaffRole {
  ADMIN
}

enum UserStatus {
  /// Created by an admin or the bootstrap CLI; Clerk account not linked yet.
  INVITED
  ACTIVE
  DEACTIVATED
}

model User {
  id            String     @id @default(uuid(7)) @db.Uuid
  /// Null until first sign-in; linked on the first authenticated request by Clerk's verified email.
  clerkUserId   String?    @unique
  /// Stored lower-cased.
  email         String     @unique
  firstName     String
  lastName      String
  phone         String?
  /// Null = not staff. Company-wide; owner/cleaner access lives in Membership.
  staffRole     StaffRole?
  status        UserStatus @default(INVITED)
  deactivatedAt DateTime?  @db.Timestamptz
  /// The guide character this user picked (Settings). Purely a display preference.
  guide         Guide      @default(SAGE)
  createdAt     DateTime   @default(now()) @db.Timestamptz
  updatedAt     DateTime   @updatedAt @db.Timestamptz

  memberships            Membership[]     @relation("MembershipUser")
  membershipsCreated     Membership[]     @relation("MembershipCreatedBy")
  membershipsRevoked     Membership[]     @relation("MembershipRevokedBy")
  invites                Invite[]         @relation("InviteUser")
  invitesSent            Invite[]         @relation("InviteInvitedBy")
  propertyPlansSet       PropertyPlan[]
  auditLogs              AuditLog[]
  idempotencyKeys        IdempotencyKey[]
  defaultCleanerFor      Property[]       @relation("PropertyDefaultCleaner")
  bookingsEntered        Booking[]
  expensesEntered        Expense[]        @relation("ExpenseEnteredBy")
  expensesVoided         Expense[]        @relation("ExpenseVoidedBy")
  receiptsUploaded       Receipt[]        @relation("ReceiptUploadedBy")
  receiptsVoided         Receipt[]        @relation("ReceiptVoidedBy")
  filesUploaded          StoredFile[]
  propertyPhotosUploaded PropertyPhoto[]
}

/// The three guide characters (docs/design/Mascots.dc.html).
enum Guide {
  SAGE
  JUNIPER
  PIP
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model Invite {
  id                String       @id @default(uuid(7)) @db.Uuid
  userId            String       @db.Uuid
  user              User         @relation("InviteUser", fields: [userId], references: [id], onDelete: Restrict)
  /// Clerk invitation id (created with notify: false; we email its link ourselves). Null when Clerk was not
  /// configured (local dev bootstrap).
  clerkInvitationId String?      @unique
  /// Id from the email provider (Resend) for the last invite email; null if none was sent (e.g. local dev).
  emailMessageId    String?
  lastSentAt        DateTime?    @db.Timestamptz
  status            InviteStatus @default(PENDING)
  /// Null when created by the bootstrap CLI.
  invitedById       String?      @db.Uuid
  invitedBy         User?        @relation("InviteInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedAt        DateTime?    @db.Timestamptz
  revokedAt         DateTime?    @db.Timestamptz
  createdAt         DateTime     @default(now()) @db.Timestamptz

  @@index([userId, status])
}

enum MembershipRole {
  OWNER
  CLEANER
}

/// The single source of property-scoped access. Every non-admin query is scoped through it.
model Membership {
  id          String         @id @default(uuid(7)) @db.Uuid
  userId      String         @db.Uuid
  user        User           @relation("MembershipUser", fields: [userId], references: [id], onDelete: Restrict)
  propertyId  String         @db.Uuid
  property    Property       @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  role        MembershipRole
  createdById String?        @db.Uuid
  createdBy   User?          @relation("MembershipCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime       @default(now()) @db.Timestamptz
  /// Soft revoke keeps a history of who had access when.
  revokedAt   DateTime?      @db.Timestamptz
  revokedById String?        @db.Uuid
  revokedBy   User?          @relation("MembershipRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)
  // + partial unique index membership_active_unique (raw SQL)

  @@index([userId, revokedAt])
  @@index([propertyId, role])
}

// ───────────────────────── Properties ─────────────────────────

model Property {
  id                           String         @id @default(uuid(7)) @db.Uuid
  /// Internal nickname shown in the UI, e.g. "Kits 2BR".
  name                         String
  addressLine1                 String
  addressLine2                 String?
  city                         String
  province                     String         @default("BC")
  postalCode                   String
  country                      String         @default("CA")
  /// IANA zone; turns stay dates/times into instants and buckets statement months.
  timeZone                     String         @default("America/Vancouver")
  /// Default "HH:mm" times used to build clean windows.
  checkInTime                  String         @default("16:00")
  checkOutTime                 String         @default("11:00")
  /// BC Short-Term Rental Registry number (platforms must display it).
  provincialRegistrationNumber String?
  /// Municipal business licence, distinct from the provincial registration.
  businessLicenceNumber        String?
  // No lockbox or door codes are stored in the app (docs/spec.md decision 2026-10-06).
  /// Cleaner assigned to new cleans by default. Must hold an active CLEANER membership here (checked in the
  /// service); cleared when that membership is revoked or the user is deactivated.
  defaultCleanerId             String?        @db.Uuid
  defaultCleaner               User?          @relation("PropertyDefaultCleaner", fields: [defaultCleanerId], references: [id], onDelete: Restrict)
  /// Cleaning fee normally charged to guests; the owner-borne charge after an OWNER_STAY (Phase 3).
  standardCleaningFeeCents     Int            @default(0)
  /// Default amount owed to the cleaner per turnover; copied onto each Clean at creation.
  defaultCleanerPayCents       Int            @default(0)
  archivedAt                   DateTime?      @db.Timestamptz
  /// The current cover photo, shown on property cards and the property page. Must be one of this property's
  /// photos (trigger). Null = none; earlier photos stay as history.
  coverPhotoId                 String?        @unique @db.Uuid
  coverPhoto                   PropertyPhoto? @relation("PropertyCover", fields: [coverPhotoId], references: [id], onDelete: Restrict)
  createdAt                    DateTime       @default(now()) @db.Timestamptz
  updatedAt                    DateTime       @updatedAt @db.Timestamptz

  memberships Membership[]
  rooms       Room[]
  plans       PropertyPlan[]
  bookings    Booking[]
  expenses    Expense[]
  receipts    Receipt[]
  files       StoredFile[]
  photos      PropertyPhoto[] @relation("PropertyPhotos")
}

/// A property's photo, as two JPEG renditions made in the browser before upload: a large one for the property page
/// and a card-sized one for lists, so a page of many properties downloads only small images. Rows are never updated
/// or deleted (trigger); a new cover is a new row, and Property.coverPhotoId points at the current one.
model PropertyPhoto {
  id           String     @id @default(uuid(7)) @db.Uuid
  propertyId   String     @db.Uuid
  property     Property   @relation("PropertyPhotos", fields: [propertyId], references: [id], onDelete: Restrict)
  /// Large rendition (long edge up to 1600px).
  fileId       String     @unique @db.Uuid
  file         StoredFile @relation("PropertyPhotoLarge", fields: [fileId], references: [id], onDelete: Restrict)
  /// Card rendition (up to 640px wide).
  thumbFileId  String     @unique @db.Uuid
  thumbFile    StoredFile @relation("PropertyPhotoThumb", fields: [thumbFileId], references: [id], onDelete: Restrict)
  uploadedById String     @db.Uuid
  uploadedBy   User       @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now()) @db.Timestamptz

  coverOf Property? @relation("PropertyCover")

  @@index([propertyId])
}

enum RoomType {
  BEDROOM
  BATHROOM
  KITCHEN
  LIVING
  DINING
  LAUNDRY
  OUTDOOR
  ENTRY
  OTHER
}

model Room {
  id         String    @id @default(uuid(7)) @db.Uuid
  propertyId String    @db.Uuid
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  /// e.g. "Primary bedroom", "Ensuite".
  name       String
  type       RoomType
  /// Order in the cleaner's photo checklist (walk-through order).
  sortOrder  Int       @default(0)
  /// Archived rooms drop out of the clean-completion requirement but keep historic photos.
  archivedAt DateTime? @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz

  /// Target of CleanPhoto's composite FK (Phase 3), proving the room belongs to the clean's property.
  @@unique([propertyId, id])
  @@index([propertyId, sortOrder])
}

// ───────────────────────── Plans ─────────────────────────

/// A management plan (e.g. TruPlan, 2200 bps). The rate is immutable once referenced (trigger) so
/// historic statements stay reproducible; new terms mean a new plan.
model Plan {
  id               String    @id @default(uuid(7)) @db.Uuid
  name             String    @unique
  description      String?
  /// Basis points of the month's owner gross (2200 = 22%).
  managementFeeBps Int
  archivedAt       DateTime? @db.Timestamptz
  createdAt        DateTime  @default(now()) @db.Timestamptz

  properties PropertyPlan[]
}

/// Which plan applied to a property from which month. Starts on the 1st so each statement month has one rate.
model PropertyPlan {
  id            String    @id @default(uuid(7)) @db.Uuid
  propertyId    String    @db.Uuid
  property      Property  @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  planId        String    @db.Uuid
  plan          Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  /// First day of a month (CHECK).
  effectiveFrom DateTime  @db.Date
  /// Exclusive; first day of a month (CHECK); null = current.
  effectiveTo   DateTime? @db.Date
  createdById   String?   @db.Uuid
  createdBy     User?     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime  @default(now()) @db.Timestamptz
  // + EXCLUDE constraint property_plan_no_overlap (raw SQL)

  @@index([propertyId, effectiveFrom])
}

// ───────────────────────── Bookings ─────────────────────────

enum BookingSource {
  /// Entered by an admin.
  MANUAL
  /// Created by the iCal sync (Phase 6): dates only; money is entered later.
  ICAL
  /// Created by a future PMS integration.
  PMS
}

enum BookingChannel {
  AIRBNB
  VRBO
  BOOKING_COM
  DIRECT
  OTHER
}

enum BookingKind {
  /// Revenue stay.
  GUEST
  /// The owner is using the property: not revenue, still gets a turnover clean.
  OWNER_STAY
  /// Maintenance or hold: no revenue, no clean.
  BLOCK
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

model Booking {
  id                   String         @id @default(uuid(7)) @db.Uuid
  propertyId           String         @db.Uuid
  property             Property       @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  /// How the record got here (rule 3); separate from channel.
  source               BookingSource
  /// Where the guest booked.
  channel              BookingChannel
  kind                 BookingKind    @default(GUEST)
  status               BookingStatus  @default(CONFIRMED)
  /// Platform confirmation code or iCal UID; (propertyId, source, externalId) is unique so imports are idempotent.
  externalId           String?
  checkInDate          DateTime       @db.Date
  /// nights = checkOutDate − checkInDate. CHECK (checkOut > checkIn).
  checkOutDate         DateTime       @db.Date
  /// Early check-in / late checkout ("HH:mm"); feed the clean window (Phase 3).
  checkInTimeOverride  String?
  checkOutTimeOverride String?
  /// PII: admin-only.
  guestName            String?
  guestCount           Int?

  // Money (GUEST only; CHECKed). Null = not entered yet, which is different from 0: such bookings are "incomplete".
  /// What the channel actually paid TruHost for the stay, after its host fee.
  payoutCents           Int?
  /// Cleaning fee charged to the guest: TruHost revenue, subtracted from payout for owner gross.
  guestCleaningFeeCents Int?
  /// Guest-paid taxes; must stay null unless TAX_FIELDS_ENABLED. Never revenue.
  taxesCollectedCents   Int?

  cancelledAt      DateTime? @db.Timestamptz
  cancellationNote String?
  /// Admin-only notes.
  notes            String?
  /// Null for iCal/PMS records.
  enteredById      String?   @db.Uuid
  enteredBy        User?     @relation(fields: [enteredById], references: [id], onDelete: Restrict)
  /// Optimistic concurrency: PATCH must send the current version; a stale one is a 409.
  version          Int       @default(0)
  createdAt        DateTime  @default(now()) @db.Timestamptz
  updatedAt        DateTime  @updatedAt @db.Timestamptz
  // + EXCLUDE booking_no_overlap and CHECKs (raw SQL in the migration)

  @@unique([propertyId, source, externalId])
  @@index([propertyId, checkInDate])
  @@index([propertyId, checkOutDate])
}

// ───────────────────────── Expenses & receipts ─────────────────────────

enum ExpenseCategory {
  /// Owner-stay cleans (system-created, Phase 3).
  CLEANING
  /// Restocks bought by TruHost (decision N12).
  SUPPLIES
  REPAIRS_MAINTENANCE
  FURNISHINGS
  UTILITIES
  INTERNET
  LICENSING_PERMITS
  INSURANCE
  STRATA
  OTHER
}

enum ExpenseBearer {
  /// Deducted on the owner's statement; needs a receipt before its month can be finalized.
  OWNER
  /// TruHost's own cost for this property; never shown to owners.
  TRUHOST
}

model Expense {
  id          String          @id @default(uuid(7)) @db.Uuid
  propertyId  String          @db.Uuid
  property    Property        @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  category    ExpenseCategory
  bearer      ExpenseBearer   @default(OWNER)
  /// Purchase date (the date on the receipt). Decides which statement month it lands in.
  incurredOn  DateTime        @db.Date
  vendor      String?
  description String
  /// Total paid including any tax: this is what is deducted. CHECK (>= 0).
  amountCents Int
  /// Tax breakdown; must stay null unless TAX_FIELDS_ENABLED.
  gstCents    Int?
  pstCents    Int?
  enteredById String          @db.Uuid
  enteredBy   User            @relation("ExpenseEnteredBy", fields: [enteredById], references: [id], onDelete: Restrict)
  /// Void instead of delete; voided rows are excluded from every money computation. Reason required (CHECK).
  voidedAt    DateTime?       @db.Timestamptz
  voidedById  String?         @db.Uuid
  voidedBy    User?           @relation("ExpenseVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  voidReason  String?
  version     Int             @default(0)
  createdAt   DateTime        @default(now()) @db.Timestamptz
  updatedAt   DateTime        @updatedAt @db.Timestamptz

  receipts Receipt[]

  /// Target of Receipt's composite FK, proving a receipt and its expense share a property.
  @@unique([propertyId, id])
  @@index([propertyId, incurredOn])
}

/// A receipt or invoice document. Usually attached to an expense (several per expense allowed).
model Receipt {
  id           String     @id @default(uuid(7)) @db.Uuid
  propertyId   String     @db.Uuid
  property     Property   @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  /// Same property as the receipt (composite FK in raw SQL).
  expenseId    String?    @db.Uuid
  expense      Expense?   @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  fileId       String     @unique @db.Uuid
  file         StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)
  receiptDate  DateTime   @db.Date
  description  String?
  uploadedById String     @db.Uuid
  uploadedBy   User       @relation("ReceiptUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  /// Void instead of delete; the file stays in storage. Reason required (CHECK).
  voidedAt     DateTime?  @db.Timestamptz
  voidedById   String?    @db.Uuid
  voidedBy     User?      @relation("ReceiptVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  voidReason   String?
  createdAt    DateTime   @default(now()) @db.Timestamptz

  @@index([propertyId, receiptDate])
  @@index([expenseId])
}

// ───────────────────────── Files ─────────────────────────

enum FilePurpose {
  RECEIPT
  CLEAN_PHOTO
  DAMAGE_PHOTO
  PROPERTY_PHOTO
}

enum FileStatus {
  /// Upload URL issued; the object may not exist yet.
  PENDING
  /// Object confirmed in storage with the declared size, type and SHA-256.
  VERIFIED
}

/// Every stored object. Access is decided by the row it is attached to (Receipt, later photos), never by this row.
model StoredFile {
  id               String      @id @default(uuid(7)) @db.Uuid
  purpose          FilePurpose
  /// Scoping key and object-key prefix: properties/{propertyId}/{purpose}/{id}.
  propertyId       String      @db.Uuid
  property         Property    @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  objectKey        String      @unique
  /// Allow-listed per purpose (images and PDF for receipts; JPEG for property photos).
  contentType      String
  sizeBytes        Int
  /// Hex SHA-256 declared by the client; storage rejects a body that doesn't match.
  sha256           String
  status           FileStatus  @default(PENDING)
  uploadedById     String      @db.Uuid
  uploadedBy       User        @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  /// Server time the upload was authorised (evidence timestamp).
  createdAt        DateTime    @default(now()) @db.Timestamptz
  /// Server time the object was confirmed in storage.
  verifiedAt       DateTime?   @db.Timestamptz
  originalFilename String?

  receipt            Receipt?
  propertyPhoto      PropertyPhoto? @relation("PropertyPhotoLarge")
  propertyPhotoThumb PropertyPhoto? @relation("PropertyPhotoThumb")

  /// Nightly purge of PENDING rows older than 24h (job comes with deploy).
  @@index([status, createdAt])
}

// ───────────────────────── Audit & infrastructure ─────────────────────────

enum ActorType {
  USER
  /// Jobs and the bootstrap CLI.
  SYSTEM
}

/// Append-only (trigger). Written in the same transaction as the change it records.
model AuditLog {
  id         String    @id @default(uuid(7)) @db.Uuid
  actorType  ActorType
  actorId    String?   @db.Uuid
  actor      User?     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  /// Dotted verb, e.g. "property.update", "membership.revoke".
  action     String
  entityType String
  entityId   String    @db.Uuid
  /// Denormalised so "everything on property X" is one indexed query.
  propertyId String?   @db.Uuid
  /// Changed fields only.
  before     Json?
  after      Json?
  requestId  String?
  ipAddress  String?
  createdAt  DateTime  @default(now()) @db.Timestamptz

  @@index([entityType, entityId])
  @@index([propertyId, createdAt])
  @@index([actorId, createdAt])
}

/// Makes POST retries safe on flaky connections; same key replays the stored response.
model IdempotencyKey {
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  key            String
  /// Hash of method + path + body; reusing a key for a different request is a 422.
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now()) @db.Timestamptz

  @@id([userId, key])
  /// Purged after 24h.
  @@index([createdAt])
}
