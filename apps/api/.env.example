PORT=3000
# Local dev database (Neon dev branch or local Postgres).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/truhost_dev
# e2e tests use this database; it is migrated and truncated by the tests.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/truhost_test

# Browser origins allowed by CORS and accepted as the Clerk token's authorized party.
CORS_ORIGINS=http://localhost:3001

# Clerk (Dashboard → API keys). The JWT key enables networkless token verification.
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
# Where invitation emails send people to finish sign-up.
INVITE_REDIRECT_URL=http://localhost:3001/sign-up

# Keep false: TruHost is not GST-registered (docs/spec.md §2).
TAX_FIELDS_ENABLED=false
