PORT=3000
# Local dev database (local Postgres, or a Neon dev branch). See CLAUDE.md "Local Postgres in WSL".
DATABASE_URL=postgresql://truhost:<password>@localhost:5432/truhost_dev
# e2e tests use this database; it is migrated and TRUNCATED by the tests.
TEST_DATABASE_URL=postgresql://truhost:<password>@localhost:5432/truhost_test

# Browser origins allowed by CORS and accepted as the Clerk token's authorized party.
CORS_ORIGINS=http://localhost:3001

# Clerk (Dashboard → API keys). The JWT key enables networkless token verification.
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
# Public URL of the web app; invite links point at ${WEB_URL}/sign-up. Placeholder until domains are chosen.
WEB_URL=http://localhost:3001

# Invite emails are sent by us through Resend (Clerk sends nothing). Without a key, emails are logged instead,
# including the sign-up link, which is fine locally. Required in production.
RESEND_API_KEY=
EMAIL_FROM="TruHost <no-reply@truhost.example>"

# Keep false: TruHost is not GST-registered (docs/spec.md §2).
TAX_FIELDS_ENABLED=false

# File storage. `local` (default) keeps files in STORAGE_LOCAL_DIR and serves signed links from this API;
# production must use `r2`. API_PUBLIC_URL is where those local links point.
STORAGE_DRIVER=local
API_PUBLIC_URL=http://localhost:3000
STORAGE_LOCAL_DIR=.storage
STORAGE_SIGNING_SECRET=change-me-to-a-long-random-string
# Cloudflare R2 (STORAGE_DRIVER=r2). The bucket needs a CORS rule allowing PUT from the web origin.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
