{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": ["TEST_DATABASE_URL", "DATABASE_URL"],
  "tasks": {
    "db:generate": {
      "inputs": ["prisma/schema.prisma"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["dist/**"]
    },
    "dev": { "dependsOn": ["^build", "db:generate"], "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^build", "db:generate"] },
    "typecheck": { "dependsOn": ["^build", "db:generate"] },
    "test": { "dependsOn": ["^build", "db:generate"] },
    "test:e2e": { "dependsOn": ["^build", "db:generate"], "cache": false }
  }
}
