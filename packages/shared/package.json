{
  "name": "@truhost/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "oxlint": "^1.58.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
